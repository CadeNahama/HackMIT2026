# Supabase — interviews and any non-map app data
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Elasticsearch — 3D map only (server-side; never expose this key)
# Same values as backend/.env
ELASTIC_URL=https://YOUR-DEPLOYMENT.es.us-east-1.aws.elastic.cloud:443
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_INDEX=hackmit-map

# Optional: "Pull live 2026" button in the Next app
# BACKEND_DIR=/absolute/path/to/backend
# BACKEND_PYTHON=/absolute/path/to/backend/.venv/bin/python
# REFRESH_SECRET=optional-shared-secret

