# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (NOT the anon key) — bypasses RLS so the script can write to gallery.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Elasticsearch (3D map index only). Elastic Cloud trial is enough.
# Deployment → Copy endpoint URL (no trailing slash) + API key.
ELASTIC_URL=https://YOUR-DEPLOYMENT.es.us-east-1.aws.elastic.cloud:443
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_INDEX=hackmit-map

# Live rebuild: python refresh.py  (or the Next.js "Pull live 2026" button)

